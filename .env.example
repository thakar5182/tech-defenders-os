# ============================================================
# Tech Defenders Business OS - Environment Configuration
# Copy this file to ".env" and adjust values as needed.
# NEVER commit a real .env with production secrets.
# ============================================================

# HTTP port the server listens on
PORT=4173

# Use production behind HTTPS; production refuses weak JWT secrets.
NODE_ENV=development

# Secret used to sign session JWTs. Use a long random string (32+ chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-string

# Durable production database (Neon PostgreSQL works with Render Free).
# Production data must not use Render's ephemeral local filesystem.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=15000
REQUIRE_PERSISTENT_STORAGE=false
MIGRATE_JSON_TO_DATABASE=false

# Required only when the first clean workspace is initialized. Keep these in
# the hosting provider's secret environment settings, never in source control.
INITIAL_SUPERADMIN_PASSWORD=
# Optional: setting this to true synchronizes the Super Admin password once on
# startup. Turn it back off immediately after recovering access.
SYNC_SUPERADMIN_PASSWORD=false

# Google Identity Services web client ID (the client secret is not used here).
GOOGLE_CLIENT_ID=
GOOGLE_AUTO_SIGNUP=true

# Days until a login session expires
SESSION_DAYS=7

# Set true only when the site itself is served over HTTPS.
COOKIE_SECURE=false

# Initialize the clean Tech Defenders workspace and login accounts when the
# database is empty. No demo business records are created.
AUTO_SEED=true

# Create a snapshot on startup and every 24 hours. Use BACKUP_DIR to change it.
AUTO_BACKUP=true
AUTO_AUTOMATION=true
# BACKUP_DIR=D:\\Tech Defenders Backups

# Never expose reset tokens in normal operation. A real deployment should
# connect forgot-password to a transactional email provider.
ALLOW_DEV_RESET_TOKEN=false

# Signup always uses a 6-digit email OTP; Email OTP Sign In is also available.
# Codes are hashed at rest, single-use, rate-limited and expire after this time.
EMAIL_OTP_TTL_MINUTES=10

# Default organization state code (used for GST intra/inter-state logic)
DEFAULT_STATE_CODE=24

# Environment label shown in the UI footer (dev/staging/prod)
APP_ENV=development

# Render reverse proxy + persistent disk (use these exact paths on Render)
TRUST_PROXY=false
# DATA_DIR=/var/data/tdos
# BACKUP_DIR=/var/data/backups

# Provider network timeout. 15000 is recommended.
PROVIDER_TIMEOUT_MS=15000

# Optional local AI quotation drafting. On Windows, SETUP.bat detects Ollama,
# starts its local service and selects/pulls a model automatically.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Email delivery. Keep every value in Render's secret environment settings;
# never put a real password or API key in source control. Default is Brevo.
# Verify support@techdefenderss.com (or its domain) with the selected provider
# before enabling the Email integration in Tech Defenders OS.
EMAIL_PROVIDER=brevo
EMAIL_FROM=support@techdefenderss.com
EMAIL_FROM_NAME=Tech Defenders
# For EMAIL_PROVIDER=smtp configure all SMTP_* values below. SMTP_SECURE=true
# is normally correct for port 465; use false for STARTTLS ports such as 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_WORKER_BATCH=10
# EMAIL_CAMPAIGN_MAX_RECIPIENTS=5000

# Brevo transactional email + signup/login OTP (EMAIL_PROVIDER=brevo).
# Brevo's free plan can be used within its current daily quota.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@techdefenderss.com
BREVO_SENDER_NAME=Tech Defenders
# BREVO_WEBHOOK_TOKEN=

# MSG91 Flow SMS (India DLT template required)
# MSG91_AUTH_KEY=
# MSG91_DEFAULT_TEMPLATE_ID=
# MSG91_WEBHOOK_TOKEN=

# Meta WhatsApp Cloud API (approved templates only)
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_GRAPH_VERSION=v23.0
# META_DEFAULT_TEMPLATE=
# META_DEFAULT_LANGUAGE=en_US
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Sandbox.co.in GST e-Invoice / E-Way Bill
# SANDBOX_API_KEY=
# SANDBOX_API_SECRET=
# SANDBOX_EINVOICE_USERNAME=
# SANDBOX_EINVOICE_PASSWORD=
# SANDBOX_GSTIN=
# SANDBOX_IRP_SOURCE=primary

# Future optional providers
# STORAGE_ACCESS_KEY=
# OCR_API_KEY=
# PAYMENT_API_KEY=
